#!/bin/zsh
set -euo pipefail

ROOT="${0:A:h}"
source "$ROOT/config.sh"

die() { print -u2 "error: $*"; exit 1; }

# Switching the loaded model restarts the generation worker for ~15s, during
# which requests are refused; every command rides that out instead of failing.
RETRIES=12
RETRY_SLEEP=3

usage() {
  cat <<EOF
kiln, local AI capability hub on $MLX_URL

Usage:
  kiln chat "message"           agent reply (reads stdin when no argument)
  kiln embed "text"             embedding JSON (reads stdin when no argument)
  kiln ocr FILE [--output DIR]  document parse to md, json, docx, layout png
  kiln doctor                   binaries, server health, loaded models
  kiln logs [-f] [-n LINES]     server log
  kiln unload                   drop on-demand models, back to agent only
  kiln service {start|stop|restart|status}
  kiln install
  kiln serve                    run the server in the foreground

The agent model is preloaded; embedding and OCR models load on first use. Only
one generation model stays resident, so alternating chat and OCR pays a reload.
EOF
}

# launchd's entry point. Tuned for a 48GB M5 Pro; read AGENTS.md before changing
# any of these, several interact badly.
cmd_serve() {
  export PATH="$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  export MLX_VLM_SERVER_API_KEY="$(< "$MLX_API_KEY_FILE")"
  exec "$MLX_SERVER_BIN" \
    --host "$MLX_HOST" \
    --port "$MLX_PORT" \
    --model "$MLX_AGENT_MODEL" \
    --draft-model "$MLX_AGENT_DRAFT_MODEL" \
    --draft-kind mtp \
    --draft-block-size 3 \
    --kv-bits 8 \
    --quantized-kv-start 2048 \
    --max-kv-size 65536 \
    --enable-thinking \
    --max-tokens 16384 \
    --prefill-step-size 2048 \
    --vision-cache-size 4 \
    --max-num-seqs 1 \
    --log-progress-interval 50
}

api_curl() {
  curl -fsS -m 10 -H "Authorization: Bearer $(< "$MLX_API_KEY_FILE")" "$@"
}

service_action() {
  local domain="gui/$(id -u)" action="$1"
  case "$action" in
    start|restart)
      launchctl print "$domain/$MLX_LABEL" >/dev/null 2>&1 || \
        launchctl bootstrap "$domain" "$HOME/Library/LaunchAgents/$MLX_LABEL.plist"
      if [[ "$action" == restart ]]; then
        launchctl kickstart -k "$domain/$MLX_LABEL"
      else
        launchctl kickstart "$domain/$MLX_LABEL"
      fi
      ;;
    stop) launchctl bootout "$domain/$MLX_LABEL" 2>/dev/null || true ;;
    status) launchctl print "$domain/$MLX_LABEL" | sed -n '1,12p' ;;
    *) die "unknown service action: $action" ;;
  esac
}

# Body is built in python so arbitrarily large stdin never hits ARG_MAX.
api_request() {
  local kind="$1" model="$2" text_file="$3"
  python3 - "$kind" "$MLX_URL" "$model" "$text_file" "$MLX_API_KEY_FILE" "$RETRIES" "$RETRY_SLEEP" <<'PY'
import json, sys, time, urllib.error, urllib.request

kind, base, model, text_path, key_path, retries, delay = sys.argv[1:]
retries, delay = int(retries), float(delay)
text = open(text_path, encoding="utf-8").read()

if kind == "chat":
    path = "/v1/chat/completions"
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": text}],
        "temperature": 0,
        "stream": False,
    }
else:
    path = "/v1/embeddings"
    payload = {"model": model, "input": text}

request = urllib.request.Request(
    base + path,
    data=json.dumps(payload).encode(),
    headers={
        "Authorization": "Bearer " + open(key_path).read().strip(),
        "Content-Type": "application/json",
    },
)

for attempt in range(retries):
    final = attempt == retries - 1
    try:
        with urllib.request.urlopen(request, timeout=600) as response:
            body = response.read().decode()
        break
    except urllib.error.HTTPError as exc:
        if exc.code not in (500, 502, 503, 504) or final:
            raise
    except OSError:
        if final:
            raise
    time.sleep(delay)

if kind == "chat":
    print(json.loads(body)["choices"][0]["message"].get("content", ""))
else:
    print(body)
PY
}

run_with_text() {
  local kind="$1" model="$2"
  shift 2
  local text="${*:-}"
  [[ -n "$text" ]] || text="$(cat)"
  [[ -n "$text" ]] || die "$kind needs text, as an argument or on stdin"
  local file rc=0
  file="$(mktemp -t kiln)"
  print -rn -- "$text" > "$file"
  api_request "$kind" "$model" "$file" || rc=$?
  rm -f "$file"
  return $rc
}

cmd_ocr() {
  [[ -x "$MLX_PADDLEOCR_BIN" ]] || die "PaddleOCR is not installed; run: kiln install"
  local input="${1:-}" output="$PWD/ocr-output"
  [[ -n "$input" ]] || die "ocr needs an image or PDF path"
  shift
  if [[ "$input" != http://* && "$input" != https://* && ! -f "$input" ]]; then
    die "OCR input not found: $input (cwd: $PWD; use an absolute path if needed)"
  fi
  while (( $# )); do
    case "$1" in
      --output) output="${2:?--output needs a directory}"; shift 2 ;;
      *) die "unknown ocr option: $1" ;;
    esac
  done
  mkdir -p "$output"
  local log attempt
  log="$(mktemp -t kiln-ocr)"
  for attempt in {1..$RETRIES}; do
    if "$MLX_PADDLEOCR_BIN" doc_parser \
      --input "$input" \
      --pipeline_version v1.6 \
      --device cpu \
      --save_path "$output" \
      --vl_rec_backend mlx-vlm-server \
      --vl_rec_server_url "$MLX_URL/" \
      --vl_rec_api_model_name "$MLX_OCR_VLM_MODEL" \
      --vl_rec_api_key "$(< "$MLX_API_KEY_FILE")" \
      --vl_rec_max_concurrency 1 >"$log" 2>&1; then
      rm -f "$log"
      print "OCR complete: $output"
      return 0
    fi
    if ! grep -Eqi 'connection error|connection refused|remote disconnected|temporarily unavailable' "$log" \
      || (( attempt == RETRIES )); then
      cat "$log" >&2
      rm -f "$log"
      return 1
    fi
    sleep "$RETRY_SLEEP"
  done
}

cmd_logs() {
  local lines=50 follow=()
  while (( $# )); do
    case "$1" in
      -f) follow=(-f); shift ;;
      -n) lines="${2:?-n needs a line count}"; shift 2 ;;
      *) die "unknown logs option: $1" ;;
    esac
  done
  [[ -f "$MLX_LOG" ]] || die "no log yet: $MLX_LOG"
  tail $follow -n "$lines" "$MLX_LOG"
}

cmd_unload() {
  # The server tears its worker down mid-response, so an empty reply is expected.
  api_curl -X POST "$MLX_URL/unload" >/dev/null 2>&1 || true
  local attempt
  for attempt in {1..$RETRIES}; do
    if api_curl "$MLX_URL/health" >/dev/null 2>&1; then
      cmd_doctor
      return 0
    fi
    sleep "$RETRY_SLEEP"
  done
  die "server did not come back after unload"
}

cmd_doctor() {
  local rc=0 health name bin
  for name bin in "server binary" "$MLX_SERVER_BIN" paddleocr "$MLX_PADDLEOCR_BIN"; do
    if [[ -x "$bin" ]]; then
      printf 'ok       %-14s %s\n' "$name" "$bin"
    else
      printf 'MISSING  %-14s %s\n' "$name" "$bin"
      rc=1
    fi
  done
  if health="$(api_curl "$MLX_URL/health" 2>/dev/null)"; then
    printf 'ok       %-14s %s\n' server "$MLX_URL"
    python3 - "$health" <<'PY'
import json, sys
health = json.loads(sys.argv[1])
loaded = health.get("loaded_models") or {}
for kind, info in loaded.items():
    print("         %-14s %s: %s" % ("loaded", kind, info.get("model")))
if not loaded:
    print("         %-14s none" % "loaded")
print("         %-14s %s" % ("context", health.get("effective_context_limit")))
PY
  else
    printf 'DOWN     %-14s %s\n' server "$MLX_URL"
    rc=1
  fi
  return $rc
}

case "${1:-help}" in
  install) exec "$ROOT/install.sh" ;;
  serve) cmd_serve ;;
  doctor) cmd_doctor ;;
  service) shift; service_action "${1:-status}" ;;
  chat) shift; run_with_text chat "$MLX_AGENT_MODEL" "$@" ;;
  embed) shift; run_with_text embed "$MLX_EMBED_MODEL" "$@" ;;
  ocr) shift; cmd_ocr "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  unload) cmd_unload ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
