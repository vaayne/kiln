#!/bin/zsh
set -euo pipefail

# Pure OpenAI-API client. No backend management: the server at KILN_BASE_URL is a
# separate process. Routing is by environment variable; defaults match the local
# omlx setup and can be overridden in the shell.

die() { print -u2 "error: $*"; exit 1; }

ROOT="${0:A:h}"
PYTHON="${KILN_PYTHON:-$ROOT/.venv-kiln/bin/python}"
if [[ ! -x "$PYTHON" ]]; then
  PYTHON="${KILN_SYSTEM_PYTHON:-$(command -v python3 || true)}"
fi
[[ -x "$PYTHON" ]] || die "Python 3 is required; run ./install.sh or set KILN_PYTHON"

BASE_URL="${KILN_BASE_URL:-http://127.0.0.1:8007}"
API_KEY="${KILN_API_KEY:-}"
if [[ -z "$API_KEY" && -n "${KILN_API_KEY_FILE:-}" && -f "${KILN_API_KEY_FILE:-}" ]]; then
  API_KEY="$(cat "$KILN_API_KEY_FILE")"
fi
[ -n "$API_KEY" ] || API_KEY="local"   # local-only: any value works.

# Model routing. Env vars win. ocr and translate fall back to KILN_MODEL per spec;
# embedding has no fallback and fails if KILN_EMBEDDING_MODEL is unset.
MODEL="${KILN_MODEL:-ornith-ai--Ornith-1.5-35B-A3B-MLX-4bit}"
OCR_MODEL="${KILN_OCR_MODEL:-$MODEL}"
EMBED_MODEL="${KILN_EMBEDDING_MODEL:-}"
TRANSLATE_MODEL="${KILN_TRANSLATE_MODEL:-$MODEL}"

# Backend reloads a model on switch, refusing connections for ~10-15s. Ride that
# out instead of failing. Override with KILN_RETRIES / KILN_RETRY_DELAY.
RETRIES="${KILN_RETRIES:-12}"
RETRY_SLEEP="${KILN_RETRY_DELAY:-3}"

usage() {
  cat <<EOF
kiln, a pure OpenAI-API client for the local server at ${BASE_URL}

Routing is by environment. Override any of these in your shell:
  KILN_BASE_URL  KILN_API_KEY  KILN_MODEL  KILN_OCR_MODEL  KILN_EMBEDDING_MODEL  KILN_TRANSLATE_MODEL

Usage:
  kiln chat "message"        agent reply (reads stdin when no argument)
  kiln translate [--lang LANG] "text"  translation (uses KILN_TRANSLATE_MODEL)
  kiln embed "text"                    embedding JSON (needs KILN_EMBEDDING_MODEL)
  kiln ocr [INSTRUCTION] PATH|URL       OCR a local image or image URL (KILN_OCR_MODEL)
  kiln models                list backend models
  kiln doctor                server health and loaded models
  kiln logs [-f] [-n LINES]  tail the server log (needs KILN_LOG)
  kiln help

ocr accepts a local image file or an http(s) URL and prints the model's output.
It does not run PaddleOCR; the OCR model performs recognition over the API.
EOF
}

# Write the message (argument, or stdin) to a temp file and echo its path. The
# file is read inside python so the heredoc stays python's stdin and large input
# never hits ARG_MAX. Returns the path; caller removes it.
write_message() {
  local file
  file="$(mktemp -t kiln-msg)"
  if (( $# > 0 )); then
    print -rn -- "$@" > "$file"
  else
    cat > "$file"
  fi
  printf '%s' "$file"
}

# kind: chat | translate | embed | ocr. For text commands, content_file holds
# the message; for ocr, ocr_input is the image path or URL.
api_request() {
  local kind="$1" model="$2" content_file="$3" ocr_input="${4:-}" instruction="${5:-}"
  "$PYTHON" - "$kind" "$BASE_URL" "$model" "$API_KEY" "$RETRIES" "$RETRY_SLEEP" "$content_file" "$ocr_input" "$instruction" <<'PY'
import base64, json, mimetypes, os, re, sys, time, pathlib, urllib.error, urllib.request

kind, base, model, key, retries, delay, content_file, ocr_input, instruction = sys.argv[1:10]


def render_text(text):
    setting = os.environ.get("KILN_RICH", "auto").lower()
    if setting == "never" or (setting != "always" and not sys.stdout.isatty()):
        print(text)
        return
    try:
        from rich.console import Console
        from rich.markdown import Markdown
    except ImportError:
        print(text)
        return
    Console().print(Markdown(text))
retries, delay = max(1, int(retries)), float(delay)

def show_error(code, body=""):
    sys.stderr.write("request failed (%s): %s\n" % (code, (body or "").strip() or code))
    sys.exit(3)

if kind == "ocr":
    path = ocr_input
    if re.match(r"^https?://", path):
        image_obj = {"type": "image_url", "image_url": {"url": path}}
    else:
        ext = pathlib.Path(path).suffix.lower()
        if ext in (".pdf", ".txt", ".html", ".docx", ".doc", ".xlsx", ".pptx"):
            sys.stderr.write("ocr: cannot pass a %s directly; convert to an image first\n" % ext)
            sys.exit(3)
        raw = pathlib.Path(path).read_bytes()
        mime = mimetypes.guess_type(path)[0] or "image/png"
        b64 = base64.b64encode(raw).decode("ascii")
        image_obj = {"type": "image_url", "image_url": {"url": "data:%s;base64,%s" % (mime, b64)}}
    endpoint = "/v1/chat/completions"
    content = [image_obj]
    if (instruction or "").strip():
        content.append({"type": "text", "text": instruction})
    payload = {"model": model, "messages": [{"role": "user", "content": content}]}
else:
    text = pathlib.Path(content_file).read_text(encoding="utf-8")
    if not text.strip():
        sys.stderr.write("needs a message, as an argument or on stdin\n")
        sys.exit(3)
    if kind == "embed":
        endpoint = "/v1/embeddings"
        payload = {"model": model, "input": text}
    elif kind == "translate":
        endpoint = "/v1/chat/completions"
        content = text
        if (instruction or "").strip():
            content = instruction + "\n\n" + text
        payload = {"model": model, "messages": [{"role": "user", "content": content}], "temperature": 0, "stream": False}
    else:
        endpoint = "/v1/chat/completions"
        payload = {"model": model, "messages": [{"role": "user", "content": text}], "temperature": 0, "stream": False}

request = urllib.request.Request(
    base.rstrip("/") + endpoint,
    data=json.dumps(payload).encode(),
    headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"},
)

final_body = ""
for attempt in range(retries):
    final = attempt == retries - 1
    try:
        with urllib.request.urlopen(request, timeout=600) as response:
            final_body = response.read().decode()
        break
    except urllib.error.HTTPError as exc:
        final_body = exc.read().decode(errors="replace")
        if exc.code in (500, 502, 503, 504) and not final:
            continue
        show_error(exc.code, final_body)
    except OSError as exc:
        if final:
            sys.stderr.write("connection failed to %s: %s\n" % (base, exc))
            sys.exit(3)
    time.sleep(delay)

if kind == "embed":
    sys.stdout.write(final_body)
else:
    try:
        render_text(json.loads(final_body)["choices"][0]["message"].get("content", ""))
    except Exception:
        sys.stderr.write(final_body)
        sys.exit(4)
PY
}

cmd_chat() {
  local file rc=0
  file="$(write_message "$@")"
  api_request chat "$MODEL" "$file" || rc=$?
  rm -f "$file"
  return $rc
}

cmd_translate() {
  local target="英文" instruction="${KILN_TRANSLATE_INSTRUCTION:-}"
  if [[ "${1:-}" == --lang || "${1:-}" == -l ]]; then
    [[ -n "${2:-}" ]] || die "${1} needs a target language"
    target="$2"
    shift 2
  fi
  [[ -n "$instruction" ]] || instruction="将以下文字翻译成${target}，只输出译文。"
  local file rc=0
  file="$(write_message "$@")"
  api_request translate "$TRANSLATE_MODEL" "$file" "" "$instruction" || rc=$?
  rm -f "$file"
  return $rc
}

cmd_embed() {
  [[ -n "$EMBED_MODEL" ]] || die "kiln embed needs KILN_EMBEDDING_MODEL set"
  local file rc=0
  file="$(write_message "$@")"
  api_request embed "$EMBED_MODEL" "$file" || rc=$?
  rm -f "$file"
  return $rc
}

cmd_ocr() {
  local instruction="${KILN_OCR_INSTRUCTION:-请识别图片中的全部文字并原样输出}"
  local image="" has_image=0 a first_nonpath=""
  # First path/http arg is the image; one preceding non-path arg is the instruction.
  for a in "$@"; do
    if [[ "$a" == http://* || "$a" == https://* || -f "$a" ]]; then
      image="$a"; has_image=1
    elif [[ -z "$first_nonpath" ]]; then
      first_nonpath="$a"
    fi
  done
  (( has_image )) || die "usage: kiln ocr [INSTRUCTION] PATH|URL"
  [[ -n "$first_nonpath" ]] && instruction="${first_nonpath}"
  api_request ocr "$OCR_MODEL" "" "$image" "$instruction"
}

cmd_models() {
  "$PYTHON" - "$BASE_URL" "$API_KEY" <<'PY'
import json, os, sys, urllib.error, urllib.request
base, key = sys.argv[1], sys.argv[2]
request = urllib.request.Request(base.rstrip("/") + "/v1/models", headers={"Authorization": "Bearer " + key})
try:
    with urllib.request.urlopen(request, timeout=10) as response:
        data = json.loads(response.read())
except urllib.error.HTTPError as exc:
    sys.stderr.write("request failed (%s): %s\n" % (exc.code, exc.read().decode(errors="replace").strip()))
    sys.exit(3)
except OSError as exc:
    sys.stderr.write("connection failed to %s: %s\n" % (base, exc)); sys.exit(3)
items = data.get("data", [])
try:
    from rich.console import Console
    from rich.table import Table
    if os.environ.get("KILN_RICH", "auto").lower() == "always" or sys.stdout.isatty():
        table = Table(title="Available models")
        table.add_column("Model", style="cyan")
        for item in items:
            table.add_row(item.get("id", ""))
        Console().print(table)
    else:
        raise ImportError
except ImportError:
    for item in items:
        print(item.get("id"))
PY
}

cmd_doctor() {
  "$PYTHON" - "$BASE_URL" "$API_KEY" <<'PY'
import json, os, sys, urllib.error, urllib.request
base, key = sys.argv[1], sys.argv[2]
request = urllib.request.Request(base.rstrip("/") + "/health", headers={"Authorization": "Bearer " + key})
try:
    with urllib.request.urlopen(request, timeout=10) as response:
        health = json.loads(response.read())
except urllib.error.HTTPError as exc:
    sys.stderr.write("server at %s returned %s\n" % (base, exc.code))
    sys.exit(3)
except OSError as exc:
    sys.stderr.write("connection failed to %s: %s\n" % (base, exc)); sys.exit(3)
try:
    from rich.console import Console
    from rich.table import Table
    if os.environ.get("KILN_RICH", "auto").lower() == "always" or sys.stdout.isatty():
        table = Table(title="Kiln backend")
        table.add_column("Field", style="cyan")
        table.add_column("Value", style="green")
        for key, value in health.items():
            table.add_row(str(key), json.dumps(value, ensure_ascii=False) if isinstance(value, (dict, list)) else str(value))
        Console().print(table)
    else:
        raise ImportError
except ImportError:
    sys.stdout.write(json.dumps(health, ensure_ascii=False) + "\n")
PY
}

cmd_logs() {
  local lines=50 follow=()
  while (( $# )); do
    case "$1" in
      -f) follow=(-f); shift ;;
      -n) lines="${2:?-n needs a line count}"; shift 2 ;;
      *) die "unknown logs option: $1" ;;
    esac
  done
  local log="${KILN_LOG:-}"
  [[ -n "$log" && -f "$log" ]] || die "no KILN_LOG configured or log not found"
  tail $follow -n "$lines" "$log"
}

case "${1:-help}" in
  chat)      shift; cmd_chat "$@" ;;
  translate) shift; cmd_translate "$@" ;;
  embed)     shift; cmd_embed "$@" ;;
  ocr)       shift; cmd_ocr "$@" ;;
  models)    shift; cmd_models "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  help|-h|--help) usage ;;
  *)         usage; exit 2 ;;
esac
